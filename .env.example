# AgentFlow 环境变量模板
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# ============================================
# LLM 配置（必须）
# ============================================
# 主力 LLM Provider: deepseek / openai / dashscope / mimo（查数请求不指定模型时用它）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash

# DeepSeek API Key（推荐，便宜，国内直连）
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI API Key（可选，备用）
# OPENAI_API_KEY=***

# 下面两家可选：配了 Key，界面右上角的模型下拉框就能选它（可选的模型见 config.py 的 MODEL_CHOICES），思考模式由代码关掉
# DashScope / 通义千问：qwen3.8-flash
# DASHSCOPE_API_KEY=***

# 小米 MiMo：mimo-v2.6-flash
# MIMO_API_KEY=***

# ============================================
# HuggingFace 加速（国内必须）
# ============================================
# BGE 模型下载镜像，国内必设，否则连不上 huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ============================================
# 服务配置
# ============================================
# 接口服务端口
FASTAPI_PORT=8000

# 界面端口：start.bat / start.sh 起的界面（vite preview），以及 Docker 里 nginx 映射到宿主机的端口
WEB_PORT=8080

# ============================================
# NL2SQL 专题库配置
# ============================================
# 专题库资料目录（四张清单、加工脚本、样例）。切换到真实资料只改这一项
MART_DIR=./data/mock_mart

# 生成 SQL 的方言：postgres（GaussDB 与 PostgreSQL 共有的语法）
SQL_DIALECT=postgres

# 执行层：none 只生成不执行；duckdb 在模拟专题库上只读执行（界面会展示结果）
EXECUTOR=none

# 单次模型调用的超时（秒）
LLM_TIMEOUT=120

# 元数据导入时的向量器：bge（默认，本地 BGE 模型）或 hash（不加载模型，测试用）
# METADATA_EMBEDDER=bge
